# Copy to .env and fill in. Values shown are the defaults from
# packages/hermes_avatar/config/defaults.yaml unless noted.

# --- Secrets -----------------------------------------------------------------
# Only needed with --voice-backend elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Config overlay ----------------------------------------------------------
# Config keys are overridden with SECTION__KEY (double underscore), matching the
# nesting in defaults.yaml. Any leaf in that file can be set this way, e.g.
# AFFECT__UPDATE_HZ=60 or BEHAVIOR__DEFAULT_MODE=mirror.
AGENT__URL=ws://127.0.0.1:18789/avatar
RENDERER__LIVETALKING_URL=http://127.0.0.1:8010
VOICE__DEVICE=cpu

# --- Standalone variables ----------------------------------------------------
# Full LuxTTS wiring. When unset, the adapter falls back to a deterministic
# local parametric voice. Placeholders: {text} {reference} {output} {device}
# {vendor_dir}
LUXTTS_COMMAND=

# Root log level (default INFO).
HERMES_LOG_LEVEL=INFO

# Hardware-aware tuning is on by default and only adjusts keys you have not set
# explicitly. Set to true/1/yes/on to opt out.
HERMES_DISABLE_HW_AWARE=
